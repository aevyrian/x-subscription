# 复制为同目录 .env 后修改生效（必须与 GalleryDL-X订阅/.env 中的值一致）
# 只读挂载同一宿主机目录为容器内 /data
GALLERYDL_DOWNLOAD_DIR=/vol1/1000/Docker/GalleryDL/downloads

# Reader 整站登录密码。真实值只放服务器本地 .env，不要提交。
LOGIN_PASSWORD=请替换为登录密码

# 可选代理；如包含账号密码，只写在本机 .env，不要写入 compose.yaml。
PROXY=

# 飞牛当前 Reader/cache 与 GalleryDL/config 的属主。
PUID=1000
PGID=994
